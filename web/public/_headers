# Security headers for the static Cloudflare Pages site. No CSP is set here:
# the app needs browser microphone access and uses locally-created blob/data URLs
# while processing a teacher-selected image.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=(), geolocation=()

# HTML and the generated service worker must be checked for updates on each visit.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache

# Vite names production assets with a content hash, so they can be cached safely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
